{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "src/app/page.js",
    "src/app/layout.js",
    "src/app/login/page.js"
, "src/app/(user)/canteens/[canteenId]/page.js", "src/app/(user)/canteens/[canteenId]/vendors/[vendorId]/page.js", "src/app/(user)/checkout/page.js", "src/app/(user)/orders/[orderId]/page.js", "src/app/(user)/orders/page.js", "src/app/(user)/page.js", "src/app/adminkantin/page.js", "src/app/(user)/payment/[orderId]/page.js"  ],
  "exclude": ["node_modules"]
}